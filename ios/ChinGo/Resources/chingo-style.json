{
  "version": 8,
  "name": "ChinGo",
  "metadata": {
    "chingo:note": "Colours here are the Ink map tokens from ChinGoDesign/Palette.swift. The basemap and the chrome floating above it have to be one product, so when a token changes it changes in both places. Tiles come from OpenFreeMap (OpenMapTiles schema, free, no key); swapping to self-hosted PMTiles on R2 is a change to the two source URLs and nothing else.",
    "chingo:maxzoom": "The tile URLs are pinned explicitly rather than fetched from TileJSON, because with a TileJSON `url` MapLibre Native kept requesting z16 tiles and OpenFreeMap answers above z14 with HTTP 200 and zero bytes rather than 404 -- which reads as a tile that is genuinely empty, so the whole map goes blank at street level instead of overzooming from z14. Declaring tiles + maxzoom inline is what makes it overzoom. The cost is that the dated path below has to be refreshed when OpenFreeMap rolls a new planet build; self-hosting on R2 removes that chore entirely."
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": [
        "https://tiles.openfreemap.org/planet/20260830_080001_pt/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "\u00a9 OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#EDE7D6"
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "residential",
            "suburb",
            "neighbourhood"
          ]
        ]
      ],
      "paint": {
        "fill-color": "#E9E2CF"
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#CFE0BC"
      }
    },
    {
      "id": "landcover-green",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "wood",
            "grass",
            "scrub",
            "farmland"
          ]
        ]
      ],
      "paint": {
        "fill-color": "#CFE0BC",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#A8D8D0"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#A8D8D0",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1,
          17,
          6
        ]
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#DDD5C2",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          11,
          2,
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk",
              "primary"
            ],
            16,
            [
              "secondary",
              "tertiary"
            ],
            12,
            8
          ],
          20,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk",
              "primary"
            ],
            44,
            [
              "secondary",
              "tertiary"
            ],
            34,
            24
          ]
        ]
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFDF7",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          11,
          1,
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk",
              "primary"
            ],
            12,
            [
              "secondary",
              "tertiary"
            ],
            9,
            6
          ],
          20,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk",
              "primary"
            ],
            36,
            [
              "secondary",
              "tertiary"
            ],
            28,
            19
          ]
        ]
      }
    },
    {
      "id": "building-3d",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-extrusion-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "get",
            "render_height"
          ],
          0,
          "#E4DCC8",
          12,
          "#DCCFB4",
          60,
          "#C6B99C"
        ],
        "fill-extrusion-height": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          0,
          15.5,
          [
            "get",
            "render_height"
          ]
        ],
        "fill-extrusion-base": [
          "case",
          [
            ">=",
            [
              "zoom"
            ],
            15.5
          ],
          [
            "get",
            "render_min_height"
          ],
          0
        ],
        "fill-extrusion-opacity": 0.95
      },
      "filter": [
        "!=",
        [
          "get",
          "hide_3d"
        ],
        true
      ]
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "city",
            "town",
            "village",
            "suburb",
            "neighbourhood"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Medium"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          11,
          16,
          15
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.08,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#6B655A",
        "text-halo-color": "#F6F2E7",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "poi-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 16,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "cafe",
            "restaurant",
            "park",
            "shop",
            "grocery",
            "bar"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-max-width": 7,
        "text-anchor": "top",
        "text-offset": [
          0,
          0.6
        ]
      },
      "paint": {
        "text-color": "#8A8377",
        "text-halo-color": "#F6F2E7",
        "text-halo-width": 1.2
      }
    }
  ]
}
