// Copy to Secrets.xcconfig (gitignored) and fill in -- or let scripts/dev-backend.sh write
// the local one for you. Absent is a working state: the app runs on seeded local data.
//
// xcconfig treats // as a comment, so a URL cannot be written straight. $() is an empty
// substitution placed BETWEEN the two slashes; the value that reaches Info.plist is the
// full URL. (Before the slashes does not work -- the comment wins.)
SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY =
TILE_BASE_URL =
