// Copy to Secrets.xcconfig (gitignored) and fill in.
// Absent is a working state: the app runs against the local mock instead of failing.
//
// The // in an https:// URL is a comment to xcconfig, so the scheme is split out
// and rejoined in code. This is the standard workaround, not a typo.
SUPABASE_URL = $()//your-project.supabase.co
SUPABASE_ANON_KEY =
TILE_BASE_URL = $()//tiles.chingo.app
